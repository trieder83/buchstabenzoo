{
  "name": "buchstabenzoo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/zoo-web --target web --release",
    "wasm:dev": "wasm-pack build ../crates/zoo-web --target web --dev",
    "dev": "npm run wasm:dev && vite --host",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "deploy:preview": "bash ../scripts/deploy-preview.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0"
  }
}
